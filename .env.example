API_URL=http://127.0.0.1:8080
PROXY=

DEEPSEEK_API_KEY=your_deepseek_api_key
ZHIPU_API_KEY=your_zhipu_api_key

SHUIMO_TOKEN=your_shuimo_token

APP_ID=your_app_id
SECRET=your_app_secret

# Comma-separated QQ user IDs that always have owner permission.
OWNER_IDS=

# Optional override for the scheduled task YAML file.
SCHEDULED_TASKS_CONFIG=config/scheduled_tasks.yaml

# Live Monitor health check used by scheduled tasks.
LIVE_MONITOR_BASE_URL=http://127.0.0.1:8000
LIVE_MONITOR_API_TOKEN=your_live_monitor_api_token
