API_URL=http://127.0.0.1:8080
PROXY=

# Revenue ranking only; independent from API_URL / Live Monitor.
REVENUE_RANK_BASE_URL=https://dc.yioio.top

DEEPSEEK_API_KEY=your_deepseek_api_key
ZHIPU_API_KEY=your_zhipu_api_key

SHUIMO_TOKEN=your_shuimo_token

APP_ID=your_app_id
SECRET=your_app_secret

# Baidu general translation API credentials, separate from QQ Bot APP_ID/SECRET.
BAIDU_TRANSLATE_APP_ID=your_baidu_translate_app_id
BAIDU_TRANSLATE_APP_KEY=your_baidu_translate_app_key

# Personal control panel. Keep this bound to 127.0.0.1 and access it through
# an SSH tunnel; do not expose the port directly to the public internet.
# Use a long random value for the token.
BOT_ADMIN_TOKEN=your_bot_admin_token
BOT_ADMIN_HOST=127.0.0.1
BOT_ADMIN_PORT=8090

# Comma-separated QQ user IDs that always have owner permission.
OWNER_IDS=

# Optional override for the scheduled task YAML file.
SCHEDULED_TASKS_CONFIG=config/scheduled_tasks.yaml

# Live Monitor health check used by scheduled tasks.
LIVE_MONITOR_BASE_URL=http://127.0.0.1:8000
LIVE_MONITOR_API_TOKEN=your_live_monitor_api_token
